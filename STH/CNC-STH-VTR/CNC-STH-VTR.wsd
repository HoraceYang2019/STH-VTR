@startuml CNC_STH_VTR

participant CNC
box "STH Services for CNC " #LightBlue
    participant STH.CTL
end box
box "STH Services for Pi" #LightSteelBlue
    participant STH.COM
    participant STH.JOB
    participant STH.CMP
end box
participant VTR

header STH
footer Page %page% of %lastpage%
title Sequence Diagrams of CNC, STH, and VTR 
caption How to 1. add Force reference; 2. detect Tool status; 3. change active tool.

'*----------------First page------------------------------*'
autonumber 1.0
autonumber inc B

group Record Reference
    activate STH.CTL
    activate VTR

    STH.CTL <-> CNC: access CNC status by timer
    VTR -> STH.JOB: start a reference job
        note right
        MQTT Topic: STH/JOB
        {"Mode": "Reference"}
        end note
    activate STH.JOB

    STH.JOB -> STH.COM: enable communicate
        note right
        MQTT Topic: STH/remt/comm
        {"Func": "Enable"}
        end note 
    activate STH.COM

    CNC -> STH.CTL: cycle start
    activate CNC
    
    STH.CTL -> STH.JOB: start record
        note left
        MQTT Topic: STH/CNC
        {"Cycle": "Start"}
        end note
    STH.JOB -> STH.CTL: check STH for linking
        note right
        MQTT Topic: STH/RDY
        {"Ready": "1"}
        end note
    STH.CTL -> CNC: update M code
    STH.JOB -> STH.COM: start record command
        note right
        MQTT Topic: STH/remt/record
        {"State": "1"}
        end note    
    STH.COM --> VTR: publish STH data 
        note right
        MQTT Topic: STH/Pdata
        {
            "MAC": /string/,
            "Power": /float/,
            "Temperature": /int/,
            "Packet Sequence Number": /int/,
            "RSSI": /int/,
            "TTOLP": /int/,        
            "Torque": [/float/,...,/float],
            "BendingX": [/float/,...,/float],
            "BendingY": [/float/,...,/float],
            "timetag": /string/
        } 
        [[file:./PData.json]]
        end note
    STH.CTL <-> CNC: query/response state
    CNC -> STH.CTL: cycle end
    deactivate CNC

    STH.CTL -> STH.JOB: stop record
        note left
        MQTT Topic: STH/CNC
        {"Cycle": "End"}
    end note
    STH.JOB -> STH.COM: stop record command
        note right
        MQTT Topic: STH/remt/record
        {"State": "0"}
        end note
    STH.JOB -> STH.COM: disable communicate
        note right
        MQTT Topic: STH/remt/comm
        {"Func":"Close"}
        end note
    deactivate STH.COM

    STH.JOB -> STH.JOB: <<merge files>>
    deactivate STH.JOB

end

'*----------------Next page------------------------------*'
newpage
autonumber 2.0
autonumber inc B

group Monitoring
== Initialization ==
    activate STH.CTL
    activate VTR
    STH.CTL <-> CNC: access CNC status by timer
    VTR -> STH.JOB: enable monitor
        note right
        MQTT Topic: STH/JOB
        {"Mode": "Monitor"}
        end note
    activate STH.JOB
    
    STH.JOB -> STH.COM: enable communicate
        note right
        MQTT Topic: STH/remt/comm
        {"Func": "Enable"}
        end note  
    activate STH.COM

    STH.CTL --> VTR: publish CNC status at inital
        note right
        MQTT Topic: STH/CNC
        {
            "NCfile": /string/, 
            "OffCoord": {"X": /float/, "Y": /float/, "Z": /float/}, 
            "SpdOver": /float/, 
            "FedOver": /float/, 
            "G54": {"X": /float/, "Y": /float/, "Z": /float/}, 
            "SpdTool": {"TCode": /int/,  "RUL": /int/},
            "RadiusComp": [/float/, .., /float/], 'mapping to T1,...,Tn'
            "RadiusWear": [/float/, .., /float/], 'mapping to T1,...,Tn'
            "LengthComp": [/float/, .., /float/], 'mapping to T1,...,Tn'
        }
        [[file:./CNC-Inital.json]]
        end note   
    alt Modify Tool RUL
    VTR -> STH.CTL: modify a tool status
        note right
        MQTT Topic: STH/CNC
        {"ChangeTool": /int/} 
        '{1: wear, 2:broken}'
        end note
    STH.CTL -> CNC: modify a tool RUL
    end alt    
    STH.CTL <-> CNC: access CNC status by timer
    CNC -> STH.CTL: cycle start
    activate CNC

    STH.CTL -> STH.JOB: start detect
        note left
        MQTT Topic: STH/CNC
        {"Cycle": "Start"}
        end note  
    STH.JOB -> STH.CTL: check STH for linking
        note right
        MQTT Topic: STH/RDY
        {"Ready": "1"}
        end note
    STH.CTL -> CNC: update M code 
    STH.JOB -> STH.CMP: start detect command
        note left
        MQTT Topic: STH/Pdetect
        {"Cmd": "Start"}
        end note
    activate STH.CMP

    STH.CMP -> STH.CMP: <<ref Reference.csv>>    
== Repetition ==
    STH.CTL <-> CNC: access CNC status by timer
    alt Update STH data by Timer (0.4s)
    STH.COM --> VTR: publish STH data
    end alt
    STH.COM -> STH.CMP:  MQTT Topic: STH/Pdata
    STH.CTL --> VTR: publish in time-interval (s)
        note right
        MQTT Topic: STH/CNC 
        {
            "LineNo": [/float/,..., /float/], '1-1 mapping'
            "NowCoord":{ 
            "X": [/float/,.., /float/], '1-1 mapping to LineNo'
            "Y": [/float/,.., /float/], '1-1 mapping to LineNo'
            "Z": [/float/,.., /float/]},'1-1 mapping to LineNo'
        }
        [[file:./CNC-Current.json]]
        end note
    STH.CTL -> STH.CMP: MQTT Topic: STH/CNC
    alt Inform Tool Alarm by Event
    STH.CMP --> VTR: update tool RUL
        note right
        MQTT Topic: STH/ALM
        {"Alarm": <"1","2","3">}
        end note
    end alt
== Completion ==
    STH.CTL <-> CNC: access CNC status by timer
    CNC -> STH.CTL: cycle end
    deactivate CNC

    STH.CTL -> STH.JOB: stop detect
        note left
        MQTT Topic: STH/CNC
        {"Cycle": "End"}
    end note
    STH.JOB -> STH.CMP: stop detect command
        note left
        MQTT Topic: STH/Pdetect 
        {"Cmd": "End"}
        end note
    deactivate STH.CMP

    STH.JOB -> STH.COM: disable communicate
    note right
    MQTT Topic: STH/remt/comm
    {"Func": "Close"}
    end note 
    deactivate STH.COM
    deactivate STH.JOB
end 

'*----------------Next page------------------------------*'
newpage
autonumber 3.0
autonumber inc B

group Change Tool
    alt ManualChangeTool
        VTR -> STH.CTL: Manual change 
            note right
            MQTT Topic: STH/CNC
            {"ChangeTool": /int/} 
            '{1: wear, 2:broken}'
            [[file:./CNC-ChangeTool.json]]
            end note
        STH.CTL -> CNC: inform CNC of the tool status 
    end
    STH.CTL <-> CNC: access CNC status by timer
    STH.CTL -> STH.JOB: actual tool being changed
        note left
        MQTT Topic: STH/CNC
        {"SpdTool": {"TCode": /int/,  "RUL": /int/}}
        [[file:./CNC-SpdTool.json]]
        end note 
    activate STH.JOB

    STH.JOB -> STH.CMP: stop detect command
        note left
        MQTT Topic: STH/Pdetect 
        {"Cmd": "End"}
        end note
    STH.JOB -> STH.COM: disable communicate
    note right
    MQTT Topic: STH/remt/comm
    {"Func":"Close"}
    end note
    STH.JOB -> STH.COM: enable communicate
        note right
        MQTT Topic: STH/remt/comm
        {"Func": "Enable"}
        end note  
    activate STH.COM

    STH.JOB -> STH.CTL: new tool connected
        note right
        MQTT Topic: STH/RDY
        {"Ready": "1"}
        end note  
    STH.CTL -> CNC: inform new STH ready

    STH.JOB -> STH.CMP: start detect command
    note left
    MQTT Topic: STH/Pdetect 
    {"Cmd": "Start"}
    end note
    activate STH.CMP
    deactivate STH.JOB

    STH.CMP -> STH.CMP: <<reset comparing>>
    deactivate STH.CMP      
end

@endum